# A 股资金流看板 - 环境变量参考
#
# 复制本文件为 .env 后按需填写（.env 已被 .gitignore 排除，不会入库）。
# 看板启动时会**自动加载** .env。
# 优先级：真正的环境变量 > .env 里的值。
# 改完 .env 要重启看板进程才生效（配置在进程启动时读一次）。

# 通达信 TdxQuant 客户端安装路径
TDX_HOME=C:\new_tdx64
TDX_EXE_NAME=TdxW.exe

# TdxQuant 单次调用超时（秒）。超过即放弃、避免后台线程卡死。
# 默认 8s；盘中可调小（如 5s），盘后建议放大（如 12s）以容忍网络抖动。
TDX_CALL_TIMEOUT=8

# 看板端口与绑定地址
# DASHBOARD_BIND 默认 127.0.0.1（仅本机，安全）；
# 两个 .bat 启动脚本显式设为 0.0.0.0 以便局域网访问——公网环境务必改回 127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_BIND=127.0.0.1

# 是否保留系统代理变量（默认 0=清掉；公司代理访问 akshare 时设 1）
DASHBOARD_KEEP_PROXY=0

# 异动信号回推通达信 TQ 策略信号窗口（tq.send_warn）：1=开（默认），0=关
TDX_SEND_WARN=1

# ============================================================
# 飞书推送
# ============================================================
# 两条通道，FEISHU_MODE 决定用哪条：
#   auto（默认）优先 app，缺 app 凭据则退 webhook
#   app / webhook / both（两个都发）/ off（整体关掉）
FEISHU_MODE=auto

# --- 通道一：自建应用（支持卡片消息，推荐）---
# 需要应用开通 im:message:send_as_bot 权限，且机器人已进群。
# 自检：python tools/feishu_test.py
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# --- 通道二：群机器人 webhook（自定义机器人）---
# 群设置里"添加机器人 → 自定义机器人"拿到的 URL。
# 留空则该通道不可用。
STOCK_FLOW_FEISHU_WEBHOOK=

# 限速（条/秒）。飞书群的 5 QPS 是**群内共享**的，别占满。
FEISHU_RATE_PER_SEC=1.5

# 推送队列上限。队列满了丢弃新消息（告警可以丢，看板不能卡）。
FEISHU_QUEUE_MAX=1000

# 整体开关：0=完全不发（调试时用）
FEISHU_ENABLED=1

# 只推这些异动类型到飞书（逗号分隔）；留空 = 全推。
# 默认只推"更重要"的：主力大额流入/流出 + 触及涨跌停。
# price_jump（价格异动）量最大但信息密度最低 —— 实测它占全天异动的 33%，
# 而真正值得看的涨跌停只有 497 只。想收就在这里加回去。
FEISHU_ALERT_TYPES=big_inflow,big_outflow,limit_up,limit_down
